# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loops-watch?retryWrites=true&w=majority

# Better Auth: any long random string, and the URL your app runs on
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Gemini API key (https://aistudio.google.com/apikey), used to write the welcome email
GEMINI_API_KEY=

# Gmail address and a Gmail App Password (not your normal password), used to send emails
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Finnhub API key (https://finnhub.io/register), used for stock market news
FINNHUB_API_KEY=
