# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loops-watch?retryWrites=true&w=majority

# Better Auth: any long random string, and the address your app runs on.
# Once deployed, set BETTER_AUTH_URL to the live address (like https://loops-watch.vercel.app).
# Links in emails also use it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Who can sign up and sign in: your own email (several can be separated by commas).
# Loops Watch is private because Finnhub's free plan is licensed for personal use.
# Left empty, nobody can sign in.
ALLOWED_EMAILS=

# Gemini API key (https://aistudio.google.com/apikey), used to write the welcome email
GEMINI_API_KEY=

# Gmail address and a Gmail App Password (not your normal password), used to send emails
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Finnhub API key (https://finnhub.io/register), used for stock market news
FINNHUB_API_KEY=

# Optional: a free Alpaca account's API keys (https://alpaca.markets, paper trading is enough), for the
# interactive heatmap's 1H, 4H, 1M, pre-market and after-hours maps and today's volume. Server-side only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Only needed once deployed: Inngest's Vercel integration adds these for you
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
